# Store text files with LF line endings. Without this, a commit from Windows
# (core.autocrlf=true) can bring in CRLF, which breaks the hooks/ shell scripts
# on macOS and Linux.
* text=auto eol=lf

# Shell scripts must use LF: CRLF makes bash fail with ": command not found".
*.sh text eol=lf
*.awk text eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files git should never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.nupkg binary
